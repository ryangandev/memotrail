// Copy this file to Secrets.xcconfig in the same directory.
// Secrets.xcconfig is ignored by Git.
// These three values are public client configuration, not server secrets.

MEMOTRAIL_SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
MEMOTRAIL_SUPABASE_PUBLISHABLE_KEY = sb_publishable_REPLACE_ME
MEMOTRAIL_GOOGLE_IOS_CLIENT_ID = REPLACE_ME.apps.googleusercontent.com
