// Copy this file to Secrets.xcconfig in the same directory.
// Secrets.xcconfig is ignored by Git.
// These values are public client configuration, not server secrets.

MEMOTRAIL_SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
MEMOTRAIL_SUPABASE_PUBLISHABLE_KEY = sb_publishable_REPLACE_ME
MEMOTRAIL_GOOGLE_IOS_CLIENT_ID = REPLACE_ME.apps.googleusercontent.com
MEMOTRAIL_GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.REPLACE_ME
// Shared authenticated media, metadata, and export API endpoint.
// For the Simulator with a running Web server: http:/$()/localhost:3000
// Geoapify and AI provider keys stay on that server; they are not iOS configuration.
// Never put an AI provider key or Supabase secret key in this file.
MEMOTRAIL_API_URL = https:/$()/memotrail.ryangan.me
