# Browser-safe application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only credential required for AI usage accounting. Never put it in iOS.
SUPABASE_SECRET_KEY=

# Optional server-only geographic search and static-map provider.
# Without this key, saved Location search and coordinate previews still work.
GEOAPIFY_API_KEY=

# Optional largest export ZIP, in bytes, that Import accepts (default 52428800, which is 50 MiB).
# The hosted Supabase Storage file size limit must be raised before a larger value works.
IMPORT_MAX_ZIP_BYTES=

# Optional AI configuration, for Chapter and year reviews and Chapter suggestions.
# Set the provider to anthropic when ready. Each person must also turn reviews on in Settings
# and accept the disclosure, and a review is only made when they ask for one.
# Before enabling this in Production, confirm the Anthropic organization behind the key has not
# opted in to any data-sharing or development program: the disclosure says MemoTrail does not
# share review text for training.
AI_PROVIDER=disabled
AI_API_KEY=
# Optional. Reviews and suggestions use claude-sonnet-5-5; a different value disables AI.
AI_REVIEW_MODEL=
# Optional address for the provider, over HTTPS (or loopback for a test double).
AI_API_BASE_URL=
# Monthly caps tracked in ai_usage. Both reset on the first of each month, UTC.
# Server-wide (default 25, at most 1000) and per person (default 3, at most 100).
AI_MONTHLY_BUDGET_USD=25
AI_USER_MONTHLY_BUDGET_USD=3

# Optional search by meaning. Server-only; never prefix with NEXT_PUBLIC_.
# This is MemoTrail's own embedding service (services/embeddings), not an AI provider,
# so Entry text and search queries stay on MemoTrail-run servers.
# Leave both empty to search by keywords only, which is the local and Preview default.
SEMANTIC_SEARCH_URL=
SEMANTIC_SEARCH_API_KEY=
