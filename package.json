{
  "name": "memotrail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm design-system:check && turbo run build",
    "design-system:check": "pnpm --filter @memotrail/design-system check",
    "design-system:export": "pnpm --filter @memotrail/design-system export",
    "design-system:generate": "pnpm --filter @memotrail/design-system generate",
    "design-system:test:previews": "pnpm --filter @memotrail/design-system test:previews",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.11.4"
  }
}
