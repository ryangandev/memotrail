      "$value": {
        "colorSpace": "srgb",
        "components": {
          "$ref": "#/palette/clay/600/$value/components"
        },
        "alpha": 0.34
      },
      "$extensions": {
        "com.memotrail": {
          "mix": {
            "colors": ["{color.danger}"],
            "weight": 0.34
          }
        }
      }
    },
    "dangerTint": {
      "$description": "Background of inline form errors.",
      "$value": {
        "colorSpace": "srgb",
        "components": {
          "$ref": "#/palette/clay/600/$value/components"
