{
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "System font stacks. Web downloads no font files; iOS draws the matching system fonts.",
      "sans": {
        "$description": "Interface text: labels, body, and controls.",
        "$value": [
          "ui-sans-serif",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "sans-serif"
        ]
      },
      "serif": {
        "$description": "Page, section, card, and dialog titles, and the wordmark.",
        "$value": [
          "ui-serif",
          "Iowan Old Style",
          "Palatino Linotype",
          "Palatino",
          "Georgia",
          "serif"
        ]
      },
      "mono": {
        "$description": "Date stamps and code.",
        "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "monospace"]
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Base font sizes that the text roles reference.",
      "caption": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "label": {
        "$value": {
          "value": 13,
          "unit": "px"
        }
      },
      "body": {
        "$value": {
          "value": 15,
          "unit": "px"
        }
      },
      "bodyLarge": {
        "$value": {
          "value": 17,
          "unit": "px"
        }
      },
      "titleSmall": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "title": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "display": {
        "$value": {
          "value": 42,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "Font weights that the text roles reference.",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    }
  },
  "lineHeight": {
    "$type": "number",
    "$description": "Line height multipliers that the text roles reference.",
    "tight": {
      "$description": "Headings, labels, and single-line text.",
      "$value": 1.15
    },
    "body": {
      "$description": "Paragraphs and multi-line text.",
      "$value": 1.55
    },
    "relaxed": {
      "$description": "Long-form reading on the sign-in screen.",
      "$value": 1.7
    }
  }
}
