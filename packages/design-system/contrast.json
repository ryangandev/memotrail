{
  "$description": "WCAG 2.2 AA text contrast checks, run in both themes on every platform that has the tokens. Each check names the smallest text role the color is used at; the role's size and weight choose the 4.5:1 body or 3:1 large text threshold. Backgrounds list layers from top to bottom with \"over\". A failing pair needs a named exception with a reason.",
  "checks": [
    {
      "text": "{color.ink}",
      "role": "{type.body}",
      "on": [
        "{color.canvas}",
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.surfaceSubtle}",
        "{color.accentSubtle}",
        "{color.accentPanel}",
        "{color.captureQueued}",
        "{color.captureRefused} over {color.surface}",
        "{color.chipSurface}",
        "{color.laneSurface}",
        "{color.warmSubtle}",
        "{color.accentTint} over {color.surfaceRaised}",
        "{color.surfaceWash} over {color.surface}"
      ]
    },
    {
      "text": "{color.inkMuted}",
      "role": "{type.caption}",
      "on": [
        "{color.canvas}",
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.surfaceSubtle}",
        "{color.chipSurface}",
        "{color.warningSubtle}"
      ]
    },
    {
      "text": "{color.inkFaint}",
      "role": "{type.caption}",
      "on": [
        "{color.canvas}",
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.surfaceSubtle}"
      ]
    },
    {
      "text": "{color.accent}",
      "role": "{type.label}",
      "on": [
        "{color.canvas}",
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.accentSubtle}",
        "{color.accentPanel}",
        "{color.accentTint} over {color.surfaceRaised}"
      ]
    },
    {
      "text": "{color.accentInk}",
      "role": "{type.label}",
      "on": ["{color.accent}", "{color.accentHover}"]
    },
    {
      "text": "{color.danger}",
      "role": "{type.caption}",
      "on": [
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.dangerSubtle}",
        "{color.dangerTint} over {color.surface}",
        "{color.dangerTint} over {color.surfaceRaised}"
      ]
    },
    {
      "text": "{color.warm}",
      "role": "{type.micro}",
      "on": ["{color.canvas}", "{color.surface}", "{color.warmSubtle}"]
    },
    {
      "text": "{color.success}",
      "role": "{type.caption}",
      "on": [
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.successSubtle}"
      ]
    },
    {
      "text": "{color.warning}",
      "role": "{type.caption}",
      "on": [
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.warningSubtle}"
      ]
    },
    {
      "text": "{color.info}",
      "role": "{type.label}",
      "on": ["{color.surfaceRaised}", "{color.infoSubtle}"]
    },
    {
      "text": "{color.surfaceRaised}",
      "role": "{type.micro}",
      "on": ["{color.ink}"]
    },
    {
      "text": "{color.inverseInk}",
      "role": "{type.micro}",
      "on": [
        "{color.inverseSurface} over {color.canvas}",
        "{color.inverseSurface} over {color.surfaceRaised}"
      ]
    },
    {
      "text": "{color.map.labelInk}",
      "role": "{type.caption}",
      "on": ["{color.map.labelSurface}"]
    }
  ],
  "exceptions": [
    {
      "name": "inkFaint metadata in light",
      "text": "{color.inkFaint}",
      "themes": ["light"],
      "on": [
        "{color.canvas}",
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.surfaceSubtle}"
      ],
      "reason": "inkFaint is the quietest tone for placeholders, timestamps, and decorative metadata. It is 2.9 to 3.4:1 in light. Text that carries meaning should move to inkMuted, or a later palette change should darken inkFaint."
    },
    {
      "name": "inkFaint metadata in dark",
      "text": "{color.inkFaint}",
      "themes": ["dark"],
      "on": [
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.surfaceSubtle}"
      ],
      "reason": "inkFaint passes on the dark canvas but is 3.6 to 4.2:1 on dark panels. Text that carries meaning should move to inkMuted, or a later palette change should lighten inkFaint."
    },
    {
      "name": "Muted text on subtle panels",
      "text": "{color.inkMuted}",
      "themes": ["light"],
      "on": ["{color.surfaceSubtle}", "{color.warningSubtle}"],
      "reason": "Muted helper text on the subtle and warning panels is 4.3:1 in light, just under AA. A later palette change should darken inkMuted or lighten the panels."
    },
    {
      "name": "Warm text in light",
      "text": "{color.warm}",
      "themes": ["light"],
      "on": ["{color.canvas}", "{color.surface}", "{color.warmSubtle}"],
      "reason": "Warm eyebrows and dates use clay 600, which is 3.7 to 4.4:1 in light. Kept so no pixel changes; a later palette change should darken clay 600."
    },
    {
      "name": "Danger text in light",
      "text": "{color.danger}",
      "themes": ["light"],
      "on": [
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.dangerSubtle}",
        "{color.dangerTint} over {color.surface}",
        "{color.dangerTint} over {color.surfaceRaised}"
      ],
      "reason": "Errors reuse the warm clay 600 palette, which is 3.7 to 4.4:1 in light on the paper surfaces, danger buttons, and error panels. A later palette change should give danger a darker light value."
    },
    {
      "name": "Warning text in light",
      "text": "{color.warning}",
      "themes": ["light"],
      "on": [
        "{color.surface}",
        "{color.surfaceRaised}",
        "{color.warningSubtle}"
      ],
      "reason": "Amber 700 warning text is 3.7 to 4.4:1 on the light paper surfaces. A later palette change should darken amber 700."
    }
  ]
}
